{
  "name": "HH.ru → Jobbot",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 30 }]
        }
      },
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "id": "1"
    },
    {
      "parameters": {
        "url": "http://localhost:8080/hh-queries",
        "options": {}
      },
      "name": "Get HH Queries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "id": "2"
    },
    {
      "parameters": {
        "jsCode": "const queries = $input.item.json;\nif (!Array.isArray(queries) || queries.length === 0) return [];\nreturn queries.map(q => ({ json: q }));"
      },
      "name": "Split Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "id": "3"
    },
    {
      "parameters": {
        "url": "=https://hh.ru/search/vacancy/rss?text={{ encodeURIComponent($json.hh_query) }}{{ $json.hh_area !== 'remote' ? '&area=' + $json.hh_area : '&schedule=remote' }}",
        "options": {
          "timeout": 15000
        }
      },
      "name": "RSS HH.ru",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [900, 300],
      "id": "4"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\n\nconst desc = item.content\n  ? item.content.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 1500)\n  : '';\n\nconst id = item.link?.match(/\\/vacancy\\/(\\d+)/)?.[1]\n         || item.guid?.match(/\\/vacancy\\/(\\d+)/)?.[1]\n         || String(Date.now());\n\nreturn [{ json: {\n  vacancy_id: id,\n  title: item.title || '',\n  salary: '',\n  company: '',\n  area: '',\n  link: item.link || '',\n  text: desc\n}}];"
      },
      "name": "Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300],
      "id": "5"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8080/vacancy",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\n  \"vacancy_id\": \"{{ $json.vacancy_id }}\",\n  \"title\": \"{{ $json.title }}\",\n  \"link\": \"{{ $json.link }}\",\n  \"text\": \"{{ $json.text }}\",\n  \"salary\": \"{{ $json.salary }}\",\n  \"company\": \"{{ $json.company }}\",\n  \"area\": \"{{ $json.area }}\"\n}",
        "options": {}
      },
      "name": "Send to Jobbot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300],
      "id": "6"
    }
  ],
  "connections": {
    "Schedule": {
      "main": [[{ "node": "Get HH Queries", "type": "main", "index": 0 }]]
    },
    "Get HH Queries": {
      "main": [[{ "node": "Split Queries", "type": "main", "index": 0 }]]
    },
    "Split Queries": {
      "main": [[{ "node": "RSS HH.ru", "type": "main", "index": 0 }]]
    },
    "RSS HH.ru": {
      "main": [[{ "node": "Format", "type": "main", "index": 0 }]]
    },
    "Format": {
      "main": [[{ "node": "Send to Jobbot", "type": "main", "index": 0 }]]
    }
  }
}
